rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function isValidSession(data) {
      return data.sessionId is string && data.sessionId.size() > 0 &&
             data.prompt is string && data.prompt.size() < 5000 &&
             data.status in ['active', 'completed', 'error'] &&
             data.uid == request.auth.uid;
    }

    function isValidEcosystem(data) {
      return data.uid == request.auth.uid &&
             data.keyDecisions is list &&
             data.deployedServices is list;
    }

    function isValidMemory(data) {
      return data.uid == request.auth.uid &&
             data.patterns is list;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /sessions/{sessionId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidSession(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidSession(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if isDocOwner();
    }

    match /ecosystem/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidEcosystem(request.resource.data);
    }

    match /memory/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidMemory(request.resource.data);
    }
  }
}
