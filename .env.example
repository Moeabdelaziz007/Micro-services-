# =====================================================================
# Amrikyy Maestro — Required environment variables
# Copy this file to `.env.local` and fill in the values. Never commit secrets.
# =====================================================================

# --- Firebase (client SDK) ---
# These run in the browser but Firebase Web API keys are domain-restricted.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# --- Server-only secrets ---
# Never prefix these with NEXT_PUBLIC_; they must stay on the server.
JULES_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
